<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>edit you chat</title>
</head>
<body>
    <h3>Edit your chat : <%=  chat._id%></h3>
    <p>From: <i> <%= chat.from %> to <%= chat.to %></i></p>

    <form method="post" action="/chats/<%= chat._id%>?_method=PUT">
        <textarea name="message" rows="10" cols="50"><%= chat.message %></textarea>
        <button>Update Chat</button>
    </form>



    
</body>
</html>
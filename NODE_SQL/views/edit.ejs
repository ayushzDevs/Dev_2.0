<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EDIT YOU DATA</title>
</head>
<body>
    <h2>You are about to edit this user : <%= user.email %></h2>
    <form method="post" action="/user/<%= user.id %>?_method=patch">
        <textarea name = "username"> <%= user.username %></textarea>
        <button>Update Username</button>
        <input type="password" name = "password" placeholder="Enter password">

    </form>
    <br>
    <a href="/user">Go Back to Users List</a>


</body>
</html>


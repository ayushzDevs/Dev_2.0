<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Data</title>
    <style>
        table , tr , td{
            border: 1px solid black;
        }
    </style>
</head>
<body>
    <h2>All the Users are:</h2>
    <table> 
        <%for(User of users){%>
    <tr>
        <td><%= User.id %></td>
        <td><%= User.username %></td>
        <td><%= User.email %></td>
        <td><%= User.password %></td>
    </tr>
<% }%>

    </table>
    
</body>
</html>



